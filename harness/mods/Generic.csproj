<!-- Builds an open-source .NET mod (cloned at build time, not stored here) for .NET Framework 4.8 like its release:
     every .cs file under $(SRC), against ScriptHookVDotNet3 and (if it uses it) LemonUI. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>$(NAME)</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS1701;CS1702;MSB3270;CS0108;CS0114;CS8632</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SRC)/**/*.cs" Exclude="$(SRC)/**/obj/**;$(SRC)/**/bin/**;$(SRC)/**/*Test*/**;$(SRC)/**/*.Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="ScriptHookVDotNet3" Version="3.6.0" ExcludeAssets="runtime" />
    <Reference Include="LemonUI.SHVDN3" Condition="'$(LEMONDLL)' != ''"><HintPath>$(LEMONDLL)</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.CSharp" /><Reference Include="System.Windows.Forms" /><Reference Include="System.Drawing" />
    <Reference Include="System.Xml" /><Reference Include="System.Xml.Linq" /><Reference Include="System.Net.Http" />
    <Reference Include="System.Data" /><Reference Include="System.Data.DataSetExtensions" /><Reference Include="System.Core" />
  </ItemGroup>
</Project>
