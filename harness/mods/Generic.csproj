<!-- Builds an open-source .NET mod (cloned at build time, not stored here): every .cs file under $(SRC), against
     the same ScriptHookV .NET the iPhone runs (these mods target its newer API than the 3.6.0 reference package). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>$(NAME)</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS1701;CS1702;MSB3270;CS0108;CS0114;CS8632;CA1416;NU1701</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SRC)/**/*.cs" Exclude="$(SRC)/**/obj/**;$(SRC)/**/bin/**;$(SRC)/**/*Test*/**;$(SRC)/**/*.Tests/**;$(SRC)/**/AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ScriptHookVDotNet3"><HintPath>$(SHVDNBUILD)/ScriptHookVDotNet3.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Windows.Forms"><HintPath>$(SHVDNBUILD)/System.Windows.Forms.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LemonUI.SHVDN3" Condition="'$(LEMONDLL)' != ''"><HintPath>$(LEMONDLL)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
